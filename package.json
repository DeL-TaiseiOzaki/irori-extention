{
	"name": "irori-extention",
	"displayName": "irori for VS Code",
	"description": "Personal Knowledge Base のワークスペースを「スキーマ層 / オントロジー層 / ナレッジベース層 / Raw データ層」のパネルに分けて表示する VS Code 拡張機能．",
	"version": "0.2.0",
	"license": "MIT",
	"publisher": "del-taiseiozaki",
	"repository": {
		"type": "git",
		"url": "https://github.com/DeL-TaiseiOzaki/irori-extention.git"
	},
	"homepage": "https://github.com/DeL-TaiseiOzaki/irori-extention#readme",
	"bugs": {
		"url": "https://github.com/DeL-TaiseiOzaki/irori-extention/issues"
	},
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#1e1e2e",
		"theme": "dark"
	},
	"pricing": "Free",
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"knowledge base",
		"PKB",
		"explorer",
		"claude",
		"agents",
		"ontology"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "irori",
					"title": "irori",
					"icon": "$(layers)"
				}
			]
		},
		"views": {
			"irori": [
				{
					"id": "irori.slot0",
					"name": "Layer 1",
					"contextualTitle": "irori"
				},
				{
					"id": "irori.slot1",
					"name": "Layer 2",
					"when": "irori.slot1.visible",
					"contextualTitle": "irori"
				},
				{
					"id": "irori.slot2",
					"name": "Layer 3",
					"when": "irori.slot2.visible",
					"contextualTitle": "irori"
				},
				{
					"id": "irori.slot3",
					"name": "Layer 4",
					"when": "irori.slot3.visible",
					"contextualTitle": "irori"
				},
				{
					"id": "irori.slot4",
					"name": "Layer 5",
					"when": "irori.slot4.visible",
					"contextualTitle": "irori"
				},
				{
					"id": "irori.slot5",
					"name": "Layer 6",
					"when": "irori.slot5.visible",
					"contextualTitle": "irori"
				},
				{
					"id": "irori.slot6",
					"name": "Layer 7",
					"when": "irori.slot6.visible",
					"contextualTitle": "irori"
				},
				{
					"id": "irori.slot7",
					"name": "Layer 8",
					"when": "irori.slot7.visible",
					"contextualTitle": "irori"
				},
				{
					"id": "irori.spike.grid",
					"type": "webview",
					"initialSize": 12,
					"name": "Grid Prototype (spike)",
					"when": "config.irori.spike.enableGrid",
					"contextualTitle": "irori"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "irori.slot0",
				"contents": "フォルダーを開くと，ファイルをレイヤーごとに整理して表示します．\n[フォルダーを開く](command:vscode.openFolder)",
				"when": "workbenchState == empty"
			},
			{
				"view": "irori.slot0",
				"contents": "このレイヤーに該当するファイルはありません．\n[レイヤー設定を開く](command:irori.configureLayers)",
				"when": "workbenchState != empty"
			},
			{
				"view": "irori.slot1",
				"contents": "このレイヤーに該当するファイルはありません．\n[レイヤー設定を開く](command:irori.configureLayers)",
				"when": "workbenchState != empty"
			},
			{
				"view": "irori.slot2",
				"contents": "このレイヤーに該当するファイルはありません．\n[レイヤー設定を開く](command:irori.configureLayers)",
				"when": "workbenchState != empty"
			},
			{
				"view": "irori.slot3",
				"contents": "このレイヤーに該当するファイルはありません．\n[レイヤー設定を開く](command:irori.configureLayers)",
				"when": "workbenchState != empty"
			},
			{
				"view": "irori.slot4",
				"contents": "このレイヤーに該当するファイルはありません．\n[レイヤー設定を開く](command:irori.configureLayers)",
				"when": "workbenchState != empty"
			},
			{
				"view": "irori.slot5",
				"contents": "このレイヤーに該当するファイルはありません．\n[レイヤー設定を開く](command:irori.configureLayers)",
				"when": "workbenchState != empty"
			},
			{
				"view": "irori.slot6",
				"contents": "このレイヤーに該当するファイルはありません．\n[レイヤー設定を開く](command:irori.configureLayers)",
				"when": "workbenchState != empty"
			},
			{
				"view": "irori.slot7",
				"contents": "このレイヤーに該当するファイルはありません．\n[レイヤー設定を開く](command:irori.configureLayers)",
				"when": "workbenchState != empty"
			}
		],
		"commands": [
			{
				"command": "irori.refresh",
				"title": "Refresh Layers",
				"category": "irori",
				"icon": "$(refresh)"
			},
			{
				"command": "irori.configureLayers",
				"title": "Configure Layers",
				"category": "irori",
				"icon": "$(gear)"
			},
			{
				"command": "irori.openToSide",
				"title": "Open to the Side",
				"category": "irori"
			},
			{
				"command": "irori.revealInExplorer",
				"title": "Reveal in Explorer View",
				"category": "irori"
			},
			{
				"command": "irori.revealFileInOS",
				"title": "Reveal in File Explorer",
				"category": "irori"
			},
			{
				"command": "irori.copyPath",
				"title": "Copy Path",
				"category": "irori"
			},
			{
				"command": "irori.copyRelativePath",
				"title": "Copy Relative Path",
				"category": "irori"
			},
			{
				"command": "irori.spike.openGrid",
				"title": "Open Grid Prototype (spike)",
				"category": "irori"
			},
			{
				"command": "irori.spike.loadSynthetic",
				"title": "Load Synthetic Vault into Grid Prototype (spike)",
				"category": "irori"
			},
			{
				"command": "irori.spike.loadWorkspace",
				"title": "Load Workspace into Grid Prototype (spike)",
				"category": "irori"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "irori.openToSide",
					"when": "false"
				},
				{
					"command": "irori.revealInExplorer",
					"when": "false"
				},
				{
					"command": "irori.revealFileInOS",
					"when": "false"
				},
				{
					"command": "irori.copyPath",
					"when": "false"
				},
				{
					"command": "irori.copyRelativePath",
					"when": "false"
				},
				{
					"command": "irori.spike.openGrid",
					"when": "config.irori.spike.enableGrid"
				},
				{
					"command": "irori.spike.loadSynthetic",
					"when": "config.irori.spike.enableGrid"
				},
				{
					"command": "irori.spike.loadWorkspace",
					"when": "config.irori.spike.enableGrid"
				}
			],
			"view/title": [
				{
					"command": "irori.refresh",
					"when": "view =~ /^irori\\.slot\\d+$/",
					"group": "navigation@1"
				},
				{
					"command": "irori.configureLayers",
					"when": "view =~ /^irori\\.slot\\d+$/",
					"group": "navigation@2"
				}
			],
			"view/item/context": [
				{
					"command": "irori.openToSide",
					"when": "view =~ /^irori\\.slot\\d+$/ && viewItem == irori.file",
					"group": "navigation@1"
				},
				{
					"command": "irori.revealInExplorer",
					"when": "view =~ /^irori\\.slot\\d+$/ && viewItem == irori.file",
					"group": "2_reveal@1"
				},
				{
					"command": "irori.revealFileInOS",
					"when": "view =~ /^irori\\.slot\\d+$/ && viewItem == irori.file",
					"group": "2_reveal@2"
				},
				{
					"command": "irori.copyPath",
					"when": "view =~ /^irori\\.slot\\d+$/ && viewItem == irori.file",
					"group": "3_copy@1"
				},
				{
					"command": "irori.copyRelativePath",
					"when": "view =~ /^irori\\.slot\\d+$/ && viewItem == irori.file",
					"group": "3_copy@2"
				}
			]
		},
		"configuration": {
			"title": "irori",
			"properties": {
				"irori.layers": {
					"type": "array",
					"markdownDescription": "レイヤーの定義．各レイヤーは独立したパネルとして表示されます（最大 8 個）．上から順に評価され，最初に一致したレイヤーが採用されます．どのレイヤーにも一致しないファイルは「その他」に入ります．パターンは「スコープルート（ワークスペース自身，または `.gitmodules` の submodule）からの相対パス」に対して評価され，スコープルート配下は親のパターンでは分類されません．`contents/` 直下以下はパターン照合を行わず，`contents/` を宣言したレイヤー（既定では Raw データ層）にそのまま入ります．`roots` を指定したレイヤーはワークスペース外のフォルダだけを走査します．",
					"default": [
						{
							"id": "schema",
							"label": "スキーマ層",
							"description": "CLI エージェントの振る舞いを規定する層（.claude, AGENTS.md など）",
							"icon": "law",
							"badge": "S",
							"color": "charts.purple",
							"patterns": [
								".claude/**",
								".claude.json",
								"CLAUDE.md",
								"CLAUDE.local.md",
								"AGENTS.md",
								".agents/**",
								".codex/**",
								".cursor/**",
								".cursorrules",
								".gemini/**",
								"GEMINI.md",
								".github/copilot-instructions.md",
								".github/instructions/**",
								".github/prompts/**",
								".windsurfrules",
								".mcp.json"
							]
						},
						{
							"id": "ontology",
							"label": "オントロジー層",
							"description": "この PKB のオントロジー（主に CSV）",
							"icon": "type-hierarchy",
							"badge": "O",
							"color": "charts.orange",
							"patterns": [
								"**/*.csv",
								"**/*.tsv",
								"ontology/**",
								"ontologies/**"
							]
						},
						{
							"id": "knowledge",
							"label": "ナレッジベース層",
							"description": "メインの知見・情報（Markdown 群）",
							"icon": "book",
							"badge": "K",
							"color": "charts.blue",
							"patterns": [
								"**/*.md",
								"**/*.mdx"
							]
						},
						{
							"id": "raw",
							"label": "Raw データ層",
							"description": "生データ置き場（contents/ などのマウント先）．外部フォルダを走査するには roots にフォルダを，patterns に \"**/*\" を設定する",
							"icon": "database",
							"badge": "R",
							"color": "charts.green",
							"patterns": [
								"contents/**",
								"raw/**",
								"data/**",
								"attachments/**"
							]
						}
					],
					"items": {
						"type": "object",
						"required": [
							"id",
							"label",
							"patterns"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "レイヤーの一意な ID（\"other\" は予約済み）"
							},
							"label": {
								"type": "string",
								"description": "パネルに表示する名前"
							},
							"description": {
								"type": "string",
								"description": "ツールチップに表示する説明"
							},
							"icon": {
								"type": "string",
								"description": "codicon の名前（例: law, book, database, type-hierarchy）"
							},
							"badge": {
								"type": "string",
								"maxLength": 2,
								"description": "標準エクスプローラーに表示するバッジ（1〜2 文字）"
							},
							"color": {
								"type": "string",
								"description": "標準エクスプローラーの装飾に使うテーマカラー ID（例: charts.blue）"
							},
							"patterns": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "スコープルートからの相対 glob パターン"
							},
							"roots": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "走査するフォルダ（絶対パス，~，またはワークスペース相対パス）．指定するとこのレイヤーはワークスペース内ファイルの分類に参加せず，patterns はフォルダ内の相対パスに対して評価されます（フォルダ全体を取り込むなら \"**/*\"）．空配列にするとこのレイヤーは何も表示しません"
							}
						}
					}
				},
				"irori.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/node_modules/**",
						"**/.git/**",
						"**/dist/**",
						"**/out/**"
					],
					"description": "走査から除外する glob パターン（ワークスペースでは `files.exclude` に加えて適用されます）"
				},
				"irori.showOtherLayer": {
					"type": "boolean",
					"default": true,
					"description": "どのレイヤーにも属さないファイルを「その他」パネルとして表示する"
				},
				"irori.compactFolders": {
					"type": "boolean",
					"default": true,
					"description": "子が 1 つしかないフォルダーを 1 行にまとめて表示する（エクスプローラーのコンパクトフォルダーと同様）"
				},
				"irori.decorateExplorer": {
					"type": "boolean",
					"default": true,
					"description": "標準エクスプローラー上のファイルにレイヤーのバッジと色を付ける"
				},
				"irori.spike.enableGrid": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "SPIKE (2026-09-08): 検証用のグリッドサイドバー試作を有効にする．既定では無効で，通常の表示には影響しない．"
				},
				"irori.followSymlinks": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "レイヤーの `roots` に指定した外部フォルダを走査するとき，中のシンボリックリンクを辿る．Google Drive のマウントをリンクで置いている場合に有効にする．循環参照は検出して打ち切り，深さとエントリ数にも上限を設けるが，リンクの先が巨大なフォルダだと走査に時間がかかる．`roots` に直接指定したフォルダ自体は，この設定に関わらず常に辿られる"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test",
		"test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\""
	},
	"dependencies": {
		"minimatch": "^10.2.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.18.0",
		"@types/vscode": "^1.105.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"mocha": "^12.0.0",
		"npm-run-all2": "^9.0.3",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.0"
	},
	"overrides": {
		"mocha": "^12.0.0"
	}
}
